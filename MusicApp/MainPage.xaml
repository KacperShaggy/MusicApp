<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicApp.MainPage"
             BackgroundColor="#34656D">

    <ScrollView>
        <StackLayout Padding="10" Spacing="15">

            <!-- Nagłówek -->
            <HorizontalStackLayout HeightRequest="80" VerticalOptions="Start">
                <Image Source="account.png" Aspect="AspectFit" HeightRequest="50" Margin="10,0,0,0"/>
                <Label Text="Witaj, Kacper" 
                       TextColor="#FAF8F1" 
                       FontFamily="Poppins-Light" 
                       FontSize="22"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontAttributes="Bold" 
                       Margin="20,0"/>
                <Button Text="Dodaj utwór" 
                        HeightRequest="40" 
                        WidthRequest="120" 
                        BackgroundColor="#334433"
                        Clicked="OnAddSongClicked"/>
            </HorizontalStackLayout>

            <!-- Lista utworów -->
            <CollectionView x:Name="SongsCollection"
                            SelectionMode="Single"
                            SelectionChanged="OnSongSelected"
                            HeightRequest="300"
                            BackgroundColor="#FAEAB1"
                            Margin="10,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="5" Padding="10" CornerRadius="10" BackgroundColor="#FAF8F1">
                            <Label Text="{Binding}" TextColor="#000" FontSize="18"/>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Sterowanie muzyką -->
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" Margin="0,20,0,0">
                <Button Text="⏮️" Clicked="OnPreviousClicked"/>
                <Button Text="▶️" Clicked="OnPlayClicked"/>
                <Button Text="⏸️" Clicked="OnPauseClicked"/>
                <Button Text="⏭️" Clicked="OnNextClicked"/>
            </HorizontalStackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>
